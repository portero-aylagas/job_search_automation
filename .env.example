# Job Search Automation - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# OpenAI API key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4

# Optional LangSmith observability
# If disabled or not configured, the application runs normally without remote tracing.
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=job-search-automation
LANGSMITH_DASHBOARD_URL=https://smith.langchain.com/
